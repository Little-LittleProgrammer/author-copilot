{
  "extends": "@author-copilot/config-typescript/node.json",
  "compilerOptions": {
    "composite": true,
    "types": ["node", "electron-vite/node"]
  },
  "include": [
    "src/renderer/src/features/assistant/conversation-state.ts",
    "src/renderer/src/features/assistant/line-diff.ts",
    "electron.vite.config.ts",
