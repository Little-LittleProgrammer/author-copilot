    "src/shared/**/*.ts",
    "src/renderer/src/features/editor/editor-text.ts",
    "src/renderer/src/features/editor/writing-statistics.ts",
    "src/renderer/src/features/project/structure-presentation.ts",
    "src/renderer/src/features/project/types.ts",
    "tests/**/*.ts"
