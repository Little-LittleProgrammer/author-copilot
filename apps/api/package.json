{
  "name": "@author-copilot/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf coverage dist *.tsbuildinfo",
    "dev": "nest start --watch --path tsconfig.build.json",
    "lint": "eslint src test --max-warnings=0",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-express": "11.1.28",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@author-copilot/config-eslint": "workspace:*",
    "@author-copilot/config-typescript": "workspace:*",
    "@nestjs/cli": "11.0.16",
    "@types/node": "24.10.1",
    "eslint": "10.7.0",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
