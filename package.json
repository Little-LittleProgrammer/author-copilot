{
  "name": "author-copilot",
  "version": "0.0.0",
  "private": true,
  "description": "Local-first writing workspace with controlled AI assistance",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24.16.0"
  },
  "scripts": {
    "boundaries": "node tooling/scripts/check-boundaries.mjs",
    "build": "turbo run build",
    "clean": "turbo run clean",
    "dev": "turbo run dev --parallel",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "git-runtime:fetch": "node tooling/scripts/fetch-git-runtime.ts",
    "git-runtime:test": "node --test tooling/scripts/git-runtime-lib.test.mjs",
    "git-runtime:verify": "node tooling/scripts/verify-git-runtime.ts",
    "lint": "turbo run lint",
    "package": "turbo run package",
    "rag-benchmark:test": "python3 -m unittest discover -s spikes/rag-benchmark/tests -v",
    "test": "pnpm git-runtime:test && pnpm rag-benchmark:test && turbo run test",
    "test:e2e": "pnpm --filter @author-copilot/desktop test:e2e",
    "typecheck": "turbo run typecheck",
    "verify": "pnpm format:check && pnpm boundaries && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm test:e2e"
  },
  "devDependencies": {
    "prettier": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "volta": {
    "node": "24.16.0",
    "pnpm": "11.7.0"
  }
}
